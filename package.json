{
  "name": "the-quiet-collapse",
  "private": true,
  "version": "0.1.0",
  "description": "THE QUIET COLLAPSE — a third-person survival game for the browser.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:bundle && pnpm test:e2e",
    "check:bundle": "node scripts/check-bundle.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs main",
    "deploy:qa": "node scripts/deploy-pages.mjs qa",
    "test:offline": "playwright test tests/e2e/offline.spec.ts --project=desktop-1080p"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.18.0",
    "@types/three": "^0.185.4",
    "eslint": "^10.1.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "@eslint/js": "^10.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
