{
  "name": "the-quiet-collapse",
  "private": true,
  "version": "0.1.0",
  "description": "THE QUIET COLLAPSE — a third-person survival game for the browser.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:bundle && pnpm test:e2e",
    "check:bundle": "node scripts/check-bundle.mjs && node scripts/check-assets.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "assets:fetch": "node scripts/assets/fetch.mjs",
    "assets:ledger": "node scripts/assets/ledger.mjs",
    "assets:build": "node scripts/assets/build.mjs",
    "docs:manual": "node scripts/manual.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs main",
    "deploy:qa": "node scripts/deploy-pages.mjs qa",
    "test:offline": "playwright test tests/e2e/offline.spec.ts --project=desktop-1080p"
  },
  "dependencies": {
    "@recast-navigation/three": "0.43.1",
    "recast-navigation": "0.43.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@playwright/test": "1.56.1",
    "@recast-navigation/generators": "0.43.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.18.0",
    "@types/three": "^0.185.4",
    "adm-zip": "0.5.16",
    "eslint": "^10.1.0",
    "jsdom": "^30.0.1",
    "meshoptimizer": "1.2.0",
    "sharp": "0.35.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.33.0"
}
