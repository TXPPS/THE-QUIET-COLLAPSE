# Static-host headers (Cloudflare Pages / Netlify syntax). Hashed assets are immutable; the shell and
# the service worker must always revalidate so updates propagate.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/*
  # script-src: wasm-unsafe-eval for meshopt/recast/Basis wasm; unsafe-eval because the Basis Universal transcoder (embind, run in KTX2Loader blob workers) builds its invokers with new Function. worker-src blob: for those workers; connect-src blob: because GLTFLoader hands embedded KTX2 textures to the transcoder as blob URLs.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
